
################ EMPIRICAL ASSIGNMENT - FUEL PRICES IN HUNGARY ################
# Data cleaning and merging

# 1. INITIAL SETUP
rm(list = ls())

library(readxl)
library(tidyverse)
library(dplyr)
library(openxlsx)
library(stargazer)
library(ggplot2)
library(tidyr)
library(sandwich)
library(modelsummary)

install.packages(c("sandwich", "modelsummary"))

file_path <- "C:/Users/pc/Downloads/emperic assigment/2024.10.01-10.07.xlsx"
stopifnot(file.exists(file_path))

normalize_name <- function(x) {
  str_to_lower(str_squish(x), locale = "hu")
}

safe_mean <- function(x) {
  if (all(is.na(x))) return(NA_real_)
  mean(x, na.rm = TRUE)
}


# 2. IMPORT ORIGINAL FUEL DATA

data <- read_excel(file_path, sheet = "Sheet1")

fuel <- data %>%
  transmute(
    DATE = as.Date(Date),
    SETTLEMENT = str_squish(as.character(Settlement)),
    COMPANY = str_to_upper(str_squish(as.character(Company)),
                           locale = "hu"),
    ADDRESS = str_squish(as.character(Address)),
    DIESEL = as.numeric(`Diesel (HUF/l)`),
    GASOLINE = as.numeric(`Gasoline (HUF/l)`)
  ) %>%
  filter(
    DATE >= as.Date("2024-10-01"),
    DATE <= as.Date("2024-10-07"),
    !is.na(SETTLEMENT), SETTLEMENT != "",
    !is.na(COMPANY), COMPANY != "",
    !is.na(ADDRESS), ADDRESS != ""
  )


# 3. WEEKLY AVERAGE PRICE PER STATION

# Average duplicated observations within the same day
fuel_daily <- fuel %>%
  group_by(SETTLEMENT, COMPANY, ADDRESS, DATE) %>%
  summarise(
    DIESEL = safe_mean(DIESEL),
    GASOLINE = safe_mean(GASOLINE),
    .groups = "drop"
  )

# One observation per individual station
fuel_weekly <- fuel_daily %>%
  group_by(SETTLEMENT, COMPANY, ADDRESS) %>%
  summarise(
    AVG_DIESEL = safe_mean(DIESEL),
    AVG_GASOLINE = safe_mean(GASOLINE),
    N_DAYS = n_distinct(DATE),
    .groups = "drop"
  ) %>%
  arrange(SETTLEMENT, COMPANY, ADDRESS) %>%
  mutate(
    STATION_ID = row_number(),
    SETTLEMENT_KEY = normalize_name(SETTLEMENT)
  )


# 4. LOCAL COMPETITION VARIABLES

fuel_weekly <- fuel_weekly %>%
  group_by(SETTLEMENT_KEY) %>%
  mutate(
    N_STATIONS_SETTLEMENT = n()
  ) %>%
  group_by(SETTLEMENT_KEY, COMPANY) %>%
  mutate(
    N_RIVAL_STATIONS = N_STATIONS_SETTLEMENT - n()
  ) %>%
  ungroup() %>%
  select(-ADDRESS)

cat("Original station observations:", nrow(fuel_weekly), "\n")


# 5. IMPORT KSH INDICATORS

read_ksh <- function(sheet, variable) {
  
  df <- read_excel(file_path, sheet = sheet) %>%
    transmute(
      SETTLEMENT_KEY = normalize_name(SETTLEMENT_NAME),
      VALUE = as.numeric(VALUE)
    ) %>%
    rename(!!variable := VALUE)
  
  stopifnot(!anyDuplicated(df$SETTLEMENT_KEY))
  df
}

population <- read_ksh(
  "Population density, 31st of Dec",
  "POPULATION_DENSITY"
)

construction <- read_ksh(
  "Number of new construction perm",
  "CONSTRUCTION_PERMITS"
)

cars <- read_ksh(
  "Passenger cars per thousand cap",
  "CARS_PER_1000"
)

earnings <- read_ksh(
  "Average monthly gross earnings ",
  "GROSS_EARNINGS"
)

arable <- read_ksh(
  "Share of arable land from the a",
  "ARABLE_LAND_SHARE"
)

accidents <- read_ksh(
  "Number of persons killed or inj",
  "ROAD_CASUALTIES"
)


# 6. MERGE ALL DATA

ksh_data <- list(
  population, construction, cars,
  earnings, arable, accidents
) %>%
  reduce(full_join, by = "SETTLEMENT_KEY")

final_data_full <- fuel_weekly %>%
  left_join(
    ksh_data,
    by = "SETTLEMENT_KEY",
    relationship = "many-to-one"
  ) %>%
  select(-SETTLEMENT_KEY)

# Remove incomplete observations
final_data <- final_data_full %>%
  drop_na()

# Scale earnings for easier coefficient interpretation
final_data <- final_data %>%
  mutate(
    EARNINGS_100K = GROSS_EARNINGS / 100000
  )

# Group small companies together to avoid too many dummies
major_companies <- final_data %>%
  count(COMPANY) %>%
  filter(n >= 10) %>%
  pull(COMPANY)

final_data <- final_data %>%
  mutate(
    COMPANY_GROUP = factor(
      if_else(COMPANY %in% major_companies,
              COMPANY, "OTHER")
    )
  )

stopifnot(
  !anyNA(final_data),
  !anyDuplicated(final_data$STATION_ID)
)

cat("Clean stations:", nrow(final_data), "\n")
cat("Settlements:", n_distinct(final_data$SETTLEMENT), "\n")
cat("Operator groups:", n_distinct(final_data$COMPANY_GROUP), "\n")


# 7. DESCRIPTIVE STATISTICS

summary(
  final_data %>%
    select(
      AVG_DIESEL, AVG_GASOLINE,
      POPULATION_DENSITY,
      CARS_PER_1000, GROSS_EARNINGS,
      CONSTRUCTION_PERMITS,
      ROAD_CASUALTIES,
      ARABLE_LAND_SHARE,
      N_RIVAL_STATIONS
    )
)


# 8. ORIGINAL OLS MODELS - KSH VARIABLES ONLY

base_controls <- paste(
  "CARS_PER_1000 + EARNINGS_100K +",
  "POPULATION_DENSITY + CONSTRUCTION_PERMITS +",
  "ROAD_CASUALTIES + ARABLE_LAND_SHARE"
)

die_base <- lm(
  as.formula(paste("AVG_DIESEL ~", base_controls)),
  data = final_data
)

gas_base <- lm(
  as.formula(paste("AVG_GASOLINE ~", base_controls)),
  data = final_data
)


# 9. IMPROVED MODELS - OPERATOR AND RIVAL STATIONS

station_controls <- paste(
  base_controls,
  "+ N_RIVAL_STATIONS + COMPANY_GROUP"
)

die_station <- lm(
  as.formula(paste("AVG_DIESEL ~", station_controls)),
  data = final_data
)

gas_station <- lm(
  as.formula(paste("AVG_GASOLINE ~", station_controls)),
  data = final_data
)


# 10. SETTLEMENT-CLUSTERED STANDARD ERRORS

models <- list(
  "Diesel: Original" = die_base,
  "Diesel: Extended" = die_station,
  "Gasoline: Original" = gas_base,
  "Gasoline: Extended" = gas_station
)

stopifnot(
  all(vapply(models, nobs, integer(1)) == nrow(final_data))
)

cluster_vcov <- lapply(models, function(m) {
  sandwich::vcovCL(
    m,
    cluster = final_data$SETTLEMENT,
    type = "HC1"
  )
})


# 11. COMPARE REGRESSIONS

modelsummary(
  models,
  vcov = cluster_vcov,
  statistic = "({std.error})",
  stars = TRUE,
  coef_omit = "COMPANY_GROUP",
  gof_omit = "AIC|BIC|Log.Lik|RMSE",
  output = "markdown",
  title = "Station-Level Determinants of Fuel Prices"
)

# Company coefficients are hidden from the main table,
# but are included in both extended regressions.


# 12. EXPORT CLEAN DATA


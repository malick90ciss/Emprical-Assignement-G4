# ==========================================================
# REGRESSIONS
# ==========================================================

# 4. SIX PROGRESSIVE MODELS

# Use earnings in units of 100,000 HUF
predictors <- c(
  "CARS_PER_1000",
  "EARNINGS_100K",
  "POPULATION_DENSITY",
  "CONSTRUCTION_PERMITS",
  "ROAD_CASUALTIES",
  "ARABLE_LAND_SHARE"
)

# Diesel models 1-6
diesel_models <- lapply(1:6, function(i) {
  lm(
    reformulate(predictors[1:i], response = "AVG_DIESEL"),
    data = final_data
  )
})

names(diesel_models) <- paste0("M", 1:6)

# Gasoline models 1-6
gasoline_models <- lapply(1:6, function(i) {
  lm(
    reformulate(predictors[1:i], response = "AVG_GASOLINE"),
    data = final_data
  )
})

names(gasoline_models) <- paste0("M", 1:6)


# 5. CLUSTERED STANDARD ERRORS

cluster_se <- function(model_list) {
  lapply(model_list, function(m) {
    sandwich::vcovCL(
      m,
      cluster = final_data$SETTLEMENT,
      type = "HC1"
    )
  })
}

# Diesel comparison
modelsummary(
  diesel_models,
  vcov = cluster_se(diesel_models),
  statistic = "({std.error})",
  stars = TRUE,
  output = "markdown",
  title = "Determinants of Diesel Prices"
)

# Gasoline comparison
modelsummary(
  gasoline_models,
  vcov = cluster_se(gasoline_models),
  statistic = "({std.error})",
  stars = TRUE,
  output = "markdown",
  title = "Determinants of Gasoline Prices"
)


# 6. EXTENDED STATION-LEVEL REGRESSIONS

# Original full models
die_base <- diesel_models[[6]]
gas_base <- gasoline_models[[6]]

# Add rival stations and operator-group effects
station_predictors <- c(
  predictors,
  "N_RIVAL_STATIONS",
  "COMPANY_GROUP"
)

die_station <- lm(
  reformulate(station_predictors, response = "AVG_DIESEL"),
  data = final_data
)

gas_station <- lm(
  reformulate(station_predictors, response = "AVG_GASOLINE"),
  data = final_data
)


# 7. FINAL REGRESSION COMPARISON

models <- list(
  "Diesel: Original" = die_base,
  "Diesel: Extended" = die_station,
  "Gasoline: Original" = gas_base,
  "Gasoline: Extended" = gas_station
)

modelsummary(
  models,
  vcov = cluster_se(models),
  statistic = "({std.error})",
  stars = TRUE,
  coef_omit = "COMPANY_GROUP",
  gof_omit = "AIC|BIC|Log.Lik|RMSE",
  output = "markdown",
  title = "Station-Level Determinants of Fuel Prices"
)
